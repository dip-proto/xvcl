// Test: Constants and template expressions
#include "includes/constants.xvcl"
#const NAME = "example"
#const PORT = 443
#const ENABLED = true
#const RATIO = 0.75  # a ratio {

backend {{NAME}} {
    .port = "{{PORT}}";
}

// Expression: boolean
#if ENABLED
set req.http.X-Enabled = "yes";
#endif

// Expression: arithmetic
#const DOUBLE_PORT = PORT * 2
set req.http.X-Port = "{{DOUBLE_PORT}}";

// Constants from a file included earlier
#const DOUBLE_TTL = SHARED_TTL * 2
set req.http.X-TTL = "{{DOUBLE_TTL}}";

// FLOAT literals never use exponent notation, but text in a string is left as Python writes it
#const SAMPLE_RATE FLOAT = 0.00005
#const HUGE FLOAT = 1e16
set var.rate = {{SAMPLE_RATE}};
set var.rate = {{HUGE}};
set req.http.X-Rate = "{{SAMPLE_RATE}}";

// Multi-line dict
#const PORTS = {
  "web": 80,
  "api": 8080,
}
#for name, port in PORTS.items()
set req.http.X-Port-{{name}} = "{{port}}";
#endfor
