// Test: Constants and template expressions
#const NAME = "example"
#const PORT = 443
#const ENABLED = true
#const RATIO = 0.75  # a ratio {

backend {{NAME}} {
    .port = "{{PORT}}";
}

// Expression: boolean
#if ENABLED
set req.http.X-Enabled = "yes";
#endif

// Expression: arithmetic
#const DOUBLE_PORT = PORT * 2
set req.http.X-Port = "{{DOUBLE_PORT}}";

// Multi-line dict
#const PORTS = {
  "web": 80,
  "api": 8080,
}
#for name, port in PORTS.items()
set req.http.X-Port-{{name}} = "{{port}}";
#endfor
