// Test: Template expressions in #let directives
#const PREFIX STRING = "item"

#inline square(x)
{{x * x}}
#endinline

sub vcl_recv {
    #for i in range(2)
    #let {{PREFIX}}{{i}} STRING = "{{PREFIX}}-{{i}}";
    set req.http.X-Item-{{i}} = var.{{PREFIX}}{{i}};
    #endfor

    // Macros expand first, so their placeholders are filled in too
    #let area INTEGER = square(3);
}
