// Test: Conditional compilation
#const ENV = "production"
#const DEBUG = false
#const VERSION = 2

// Simple if
#if DEBUG
set req.http.X-Debug = "enabled";
#endif

// If-else
#if ENV == "production"
set req.http.X-Env = "prod";
#else
set req.http.X-Env = "dev";
#endif

// If-elif-else: only the first true branch is kept
#if VERSION == 2
set req.http.X-Version = "v2";
#elif VERSION > 1
set req.http.X-Version = "newer";
#else
set req.http.X-Version = "unknown";
#endif

// Nested conditionals
#if ENV == "production"
#if VERSION >= 2
set req.http.X-Feature = "new";
#endif
#endif

// Multi-line #elif, with a nested block in the branch that is taken
#if VERSION == 1
set req.http.X-Range = "one";
#elif	VERSION in [
  2,
  3
]
#if VERSION == 2
set req.http.X-Range = "two";
#endif
#endif

// No branch taken
#if VERSION == 8
set req.http.X-Never = "8";
#elif VERSION == 9
set req.http.X-Never = "9";
#endif // VERSION

// Directives inside a block comment are just text
#if ENV == "production"
/*
#else
*/
set req.http.X-Commented = "kept";
#endif

// A comment that starts with "#if" isn't a nested block
#if DEBUG
#if-none-match is handled elsewhere
set req.http.X-Debug = "on";
#else
set req.http.X-Debug = "off";
#endif
