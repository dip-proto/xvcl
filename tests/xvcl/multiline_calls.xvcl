// Test: Multi-line function calls
#def process(input STRING, prefix STRING, suffix STRING) -> STRING
    declare local var.result STRING;
    set var.result = prefix + input + suffix;
    return var.result;
#enddef

#def size_class(choice STRING) -> STRING
#for option in [
    "small",
    "large"
]
    if (choice == "{{option}}") {
        return "{{option}}";
    }
#endfor
    return "none";
#enddef

#def wrap(input STRING) -> STRING
    #let wrapped STRING = process(
        input,
        "<",
        ">"
    );
    return var.wrapped;
#enddef

sub vcl_recv {
    declare local var.result STRING;

    // Multi-line function call
    set var.result = process(
        req.http.Host,
        "prefix_",
        "_suffix"
    );

    // Another multi-line call with more complex args
    set var.result = process(
        "input_string",
        "<<",
        ">>"
    );

    // Multi-line calls after a multi-line #for list
#for suffix in [
    "_a",
    "_b"
]
    set var.result = process(
        req.http.Host,
        "",
        "{{suffix}}"
    );
#endfor
    set var.result = size_class(req.http.X-Size);
    set var.result = wrap(var.result);
}
